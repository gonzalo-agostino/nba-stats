# Local storage paths (optional overrides)
NBA_STATS_DATA_DIR=data
NBA_STATS_LOG_LEVEL=INFO

# nba_api HTTP client settings
NBA_API_TIMEOUT_SECONDS=45
NBA_API_MIN_DELAY_SECONDS=0.9
NBA_API_MAX_DELAY_SECONDS=1.6
NBA_API_MAX_RETRIES=4

# Phase 3: Vertex AI (Gemini)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL_NAME=gemini-3.8-flash

# Phase 3: LangSmith observability & evals
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nba-stats

# The Odds API (NBA Player Props lines & automated Win Rate tracking)
THE_ODDS_API_KEY=

# Cloud deployment (Vercel + Hugging Face Spaces + HF Dataset persistence)
CORS_ORIGINS=
HF_DATASET_REPO=tu-usuario/nba-stats-data
HF_TOKEN=
